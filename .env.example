# Copy to .env only on first setup. Never commit real credentials.
OPSMIND_ENVIRONMENT=development
OPSMIND_LOG_LEVEL=INFO
# Run scripts/setup_local_mysql.py locally to populate these three URLs.
# Application account: SELECT, INSERT, UPDATE on opsmind_dev only.
OPSMIND_DATABASE_URL=
# Migration account: schema management on opsmind_dev only.
OPSMIND_MIGRATION_DATABASE_URL=
# Dedicated test account: opsmind_test only; tests refuse other database names.
OPSMIND_TEST_DATABASE_URL=
# Local demo identity. This is NOT a login/authentication system.
OPSMIND_DEMO_EMPLOYEE_NO=EMP-1001
